{
  "dashboard": {
    "title": "CountyPay System Health",
    "description": "Real-time monitoring of CountyPay backend performance",
    "tags": ["countypay", "system", "payments"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "HTTP Requests (5min)",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": []
          }
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Payments Completed (5min)",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(payments_total{status=\"completed\"}[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Avg Response Time",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Error Rate",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(errors_total[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "value": null, "color": "green" },
                { "value": 0.01, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "type": "graph",
        "title": "Payment Processing Duration",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(payment_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(payment_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ]
      },
      {
        "id": 6,
        "type": "graph",
        "title": "HTTP Request Rate",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{ method }} {{ route }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "type": "piechart",
        "title": "Payment Status Distribution",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "sum by (status) (increase(payments_total[1h]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "type": "graph",
        "title": "Payment Amount Total",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "sum by (provider) (increase(payment_amount_total[1h]))",
            "legendFormat": "{{ provider }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "type": "graph",
        "title": "Database Query Duration",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{ operation }}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "type": "graph",
        "title": "Active HTTP Requests",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "sum by (method, route) (http_active_requests)",
            "legendFormat": "{{ method }} {{ route }}",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
